# ─────────────────────────────────────────────────────────────
# BaseKey CRM — Environment Variables
# Copy this file to `.env` (local dev) or set these in your host's
# environment/secrets manager (Vercel: Project → Settings → Environment
# Variables). Every variable below is actually read somewhere in the
# codebase — nothing speculative.
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres, via Prisma) ──
# Supabase gives you two connection strings on the project's
# Settings → Database page:
#   DATABASE_URL — the POOLED (Supavisor/PgBouncer) connection, port 6543.
#     Used by the running app (serverless-friendly). Add
#     `?pgbouncer=true&connection_limit=1` if you see connection errors on
#     Vercel.
#   DIRECT_URL   — the DIRECT connection, port 5432. Used only by
#     `prisma migrate deploy` / `prisma migrate dev`, which need a real
#     (non-pooled) connection.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Encryption at rest (WhatsApp access token, AI provider keys) ──
# Generate with: openssl rand -base64 32
# If this is unset, secrets are stored in plain text (dev-only fallback) —
# always set this in production.
APP_ENCRYPTION_KEY=""

# ── NextAuth ──
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="https://your-domain.com"

# ── NextAuth OAuth Providers (only fill in the ones you actually enable; business-owner/ROOT login only) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# Client-side Google Sign-In button (Contacts page → "Import from Google")
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ── WhatsApp Cloud API (Meta) ──
# NOTE: phoneNumberId / businessAccountId / accessToken / verifyToken are
# stored in the database (SystemSettings, via the Settings page, encrypted
# at rest — see APP_ENCRYPTION_KEY above) rather than env vars, so the app
# can be reconfigured without a redeploy.
#
# META_APP_SECRET is required: it's your Meta App's "App Secret" (App
# Dashboard → Settings → Basic), used to verify that incoming /api/webhook
# requests really came from Meta (HMAC of the raw body against
# X-Hub-Signature-256). Without it, webhook POSTs are rejected outright.
META_APP_SECRET=""

# ── Push Notifications (Web Push / VAPID) ──
# Generate with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@your-domain.com"

# ── AI Bot (Multi-Provider) ──
# These are fallbacks used only if a key isn't set in Settings → AI Bot.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ── Cloudinary (media uploads: chat attachments, templates, flow builder) ──
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ── Transactional Email (OTP / password reset / team invites) ──
RESEND_API_KEY=""

# ── Mobile app API ──
# Generate with: openssl rand -base64 48
MOBILE_JWT_SECRET=""

# ── App URLs ──
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_BASE_URL="https://your-domain.com"

# ── Runtime ──
NODE_ENV="production"
