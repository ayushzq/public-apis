# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Neon (Serverless PostgreSQL) — get these from your Neon project dashboard.
# DIRECT_URL is used for migrations (non-pooled); DATABASE_URL is the
# pooled connection string your app uses at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.neon.tech/dbname?sslmode=require"

# JWT
JWT_SECRET="replace-with-a-long-random-string"

# Mail — choose ONE provider
MAIL_PROVIDER=smtp # or "resend"
MAIL_FROM="WhatsApp Clone <no-reply@example.com>"

# SMTP (used when MAIL_PROVIDER=smtp), e.g. Gmail App Password or any SMTP host
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Resend (used when MAIL_PROVIDER=resend) — https://resend.com
RESEND_API_KEY=

# --- Added for real WhatsApp linking + media (does not touch anything above) ---

# Cloudinary — used to store real media (photos/videos/docs/voice notes)
# sent and received over the real WhatsApp connection. Get these from
# your Cloudinary dashboard (Settings → Access Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Where Baileys stores each user's WhatsApp login credentials on disk
# (multi-file auth state). On Render, point this at a persistent disk
# mount (e.g. "/data/wa-sessions") so you don't have to re-scan the QR
# code every time the service restarts/redeploys. Defaults to
# "<backend>/wa-sessions" if unset.
WA_SESSIONS_DIR=./wa-sessions
