# URL of the Express backend's REST API
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# URL of the Express backend's Socket.io server
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Set to "false" once the backend + OTP email flow is live.
# When true (default), the app shows a "Continue with demo account"
# button so you can preview the UI with mock data instantly.
NEXT_PUBLIC_DEMO_MODE=true
